{
    "name": "netflex/query-builder",
    "description": "Netflex QueryBuilder library",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "netflex",
        "query",
        "lucene"
    ],
    "authors": [
        {
            "name": "Thomas Alrek",
            "email": "thomas@apility.no"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Netflex\\Query\\": ""
        },
        "files": [
            "helpers.php"
        ]
    },
    "require": {
        "facade/ignition-contracts": "^1.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/support": "^13.0",
        "netflex/api": "^7.0",
        "php": "^8.4"
    },
    "require-dev": {
        "illuminate/cache": "^13.0",
        "illuminate/filesystem": "^13.0",
        "phpunit/phpunit": "^12.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Netflex\\Query\\Providers\\QueryBuilderServiceProvider",
                "Netflex\\Query\\Providers\\SearchServiceProvider"
            ],
            "aliases": {
                "Search": "Netflex\\Query\\Facades\\Search",
                "Query": "Netflex\\Query\\Facades\\QueryBuilderFacade",
                "QueryAssoc": "Netflex\\Query\\Facades\\QueryBuilderFacade"
            }
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml --testdox --colors=always"
    }
}
